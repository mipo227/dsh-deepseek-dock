{
  "name": "dsh-deepseek-dock",
  "version": "0.3.0",
  "description": "Liquid-glass DeepSeek dock for DeepSeek Harness: account balance, session tokens/cost and todo progress in the bottom-right corner.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "preview.html",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "token",
    "todo",
    "widget",
    "liquid-glass"
  ],
  "license": "MIT",
  "author": "mipo227",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mipo227/dsh-deepseek-dock.git"
  },
  "homepage": "https://github.com/mipo227/dsh-deepseek-dock#readme",
  "bugs": {
    "url": "https://github.com/mipo227/dsh-deepseek-dock/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
